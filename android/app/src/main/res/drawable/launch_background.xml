<?xml version="1.0" encoding="utf-8"?>
<!-- Modify this file to customize your launch splash screen -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Matches AppTheme.light()'s ColorScheme.surface (app_theme.dart) so
         there's no flash of plain white between this splash and Flutter's
         first frame. -->
    <item android:drawable="@color/launch_background_light" />
    <item android:drawable="@drawable/splash_logo" android:gravity="center" />
</layer-list>
