# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Mizo Bible project-specific
#
# Copyrighted Bible source PDFs. The Mizo CL 1995 text is
# (c) 1995 Bible Society of India -- these must never enter the repo.
/source_pdfs/

# Supabase credentials passed via --dart-define-from-file.
# See dart_define.example.json for the expected shape.
/dart_define.json
.env
.env.*
!.env.example

# Generated Bible database. Rebuild with: python tool/build_bible_db.py
# ~30MB binary; regenerable from the pipeline, so not worth versioning.
/assets/db/*.db
/assets/db/*.db-journal

# Pipeline scratch output
/tool/_out/
